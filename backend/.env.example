# Twilio account credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio number that calls/texts are sent from (E.164, e.g. +15551234567)
TWILIO_PHONE_NUMBER=

# The salesperson's own phone — Twilio rings this first, then bridges to the lead
AGENT_PHONE_NUMBER=

# Publicly reachable base URL for this server, so Twilio can hit the TwiML
# webhook when the agent answers. In local dev, use an ngrok URL, e.g.
# https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=

PORT=4000
CORS_ORIGIN=http://localhost:3000
